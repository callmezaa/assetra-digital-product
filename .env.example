# ─── Supabase ───────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── App URL ─────────────────────────────────────────────────────────────────────
# Local: http://localhost:3000 | Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Midtrans Payment Gateway ────────────────────────────────────────────────────
# Get these from: Midtrans Dashboard > Settings > Access Keys
# Use Sandbox keys for development, Production keys for live deployment
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxx
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ─── Resend (Transactional Email) ────────────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ─── Google AI (for AI features) ─────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxx
